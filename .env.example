# Enables the judgment layer (DESIGN.md §7). Without it the app still runs:
# every deterministic figure is computed as normal and the agent falls back to
# the plain band rule, labelled as such in the UI.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-6 (per DESIGN.md §7).
# claude-opus-5 also works — sampling params are omitted automatically for
# models that reject them, so no other change is needed.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. Only needed to capture the MCP tool list (npm run mcp:discover)
# and to place orders. Obtain by connecting the server in an MCP client that
# performs the OAuth flow — see README "Connecting the MCP server".
# BINANCE_MCP_TOKEN=
