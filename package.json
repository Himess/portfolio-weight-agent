{
  "name": "portfolio-weight-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Selling your winners and buying your losers is psychologically hard. The agent proposes it; you approve it.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "klines": "node --env-file-if-exists=.env --import tsx scripts/fetch-klines.ts",
    "replay": "node --env-file-if-exists=.env --import tsx scripts/replay.ts",
    "mcp:discover": "node --env-file-if-exists=.env --import tsx scripts/discover-mcp-tools.ts",
    "env:check": "node --env-file-if-exists=.env --import tsx scripts/env-check.ts",
    "llm:check": "node --env-file-if-exists=.env --import tsx scripts/llm-check.ts",
    "hold:example": "node --env-file-if-exists=.env --import tsx scripts/hold-example.ts",
    "backtest": "node --env-file-if-exists=.env --import tsx scripts/backtest.ts",
    "demo:dataset": "node --env-file-if-exists=.env --import tsx scripts/make-demo-dataset.ts",
    "watch:preview": "node --env-file-if-exists=.env --import tsx scripts/watch-preview.ts",
    "watch:scan": "node --env-file-if-exists=.env --import tsx scripts/watch-scan.ts",
    "bands": "node --env-file-if-exists=.env --import tsx scripts/band-sweep.ts",
    "bundle": "node --import tsx scripts/bundle.ts",
    "mcp": "node --env-file-if-exists=.env --import tsx src/mcp/stdio.ts",
    "mcp:check": "node --env-file-if-exists=.env --import tsx scripts/mcp-check.ts",
    "decisions": "node --env-file-if-exists=.env --import tsx scripts/decision-log.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
